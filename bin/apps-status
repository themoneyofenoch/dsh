  fs.mkdirSync(path.dirname(PAGE_FILE), { recursive: true });
  fs.writeFileSync(PAGE_FILE, html);
  return PAGE_FILE;
}

async function main() {
  const g = loadGates();
  if (VERB === 'gates') {
    if (args[1] === 'set') {
      const [, , kind, key, value] = args;
      if (!['version', 'submit', 'spend'].includes(kind)) die('kind must be version|submit|spend');
      const cur = loadGates();
      if (kind === 'version') { cur.version = cur.version || {}; cur.version[key] = value; }
      if (kind === 'submit') cur.submit = { key, at: new Date().toISOString() };
      if (kind === 'spend') { cur.spend = cur.spend || []; cur.spend.push(key); }
      fs.mkdirSync(STATE, { recursive: true });
      fs.writeFileSync(GATE_FILE, JSON.stringify(cur, null, 2));
      appendLog(`GATE ${kind} ${key}${value ? ' ' + value : ''} recorded`);
      console.log(`GATE SET ${kind} ${key} ${value}`);
      return;
    }
    if (args[1] === 'clear') {
      const kind = args[2], key = args[3];
      const cur = loadGates();
      if (kind === 'version') { if (key) delete cur.version[key]; else cur.version = {}; }
      else if (kind === 'submit') cur.submit = null;
      else if (kind === 'spend') cur.spend = key ? (cur.spend || []).filter((x) => x !== key) : [];
      else die('kind must be version|submit|spend');
      fs.mkdirSync(STATE, { recursive: true });
      fs.writeFileSync(GATE_FILE, JSON.stringify(cur, null, 2));
      appendLog(`GATE ${kind} ${key || ''} cleared`.replace(/\s+/g, ' '));
      console.log(`GATE CLEARED ${kind} ${key || ''}`.replace(/\s+/g, ' '));
      return;
    }
    console.log(JSON.stringify(g, null, 2));
    return;
  }

  // page: render the last JSON, no network
  if (VERB === 'page') {
    const p = safeJson(OUT_FILE);
    if (!p) die('no state yet — run apps-status first');
    console.log('page → ' + renderPage(p) + '  (from state ' + p.generatedAt + ')');
    return;
  }

  // writes: delegate to storeship, in the app's folder, and print the exact call
  const STORESHIP_VERBS = ['state', 'listing', 'privacy', 'category', 'age', 'rights', 'pricing', 'review', 'shots', 'build', 'upload', 'attach', 'testflight', 'validate', 'play-init', 'play-listing', 'play-shots', 'play-bundle', 'play-track', 'play-notes', 'init'];
  if (STORESHIP_VERBS.includes(VERB)) {
    const slug = args[1];
    const app = APPS.find((a) => a.slug === slug);
    if (!app) die('unknown app: ' + slug + ' (use ' + APPS.map((a) => a.slug).join(', ') + ')');
    if (VERB === 'state' || VERB === 'validate') assertGate('none', '', '');
    const rest = args.slice(2);
    const cmd = [STORESHIP, VERB, ...rest];
    writeCall(`cd ${app.dir} && ASC_BUNDLE=${app.bundleId} PLAY_PACKAGE=${app.playPackage} ${cmd.join(' ')}`);
    const r = spawnSync(STORESHIP, [VERB, ...rest], {
      cwd: app.dir,
      stdio: 'inherit',
      env: { ...process.env, ASC_BUNDLE: app.bundleId, PLAY_PACKAGE: app.playPackage },
    });
    process.exit(r.status ?? 0);
  }

  // refusal verbs — these are never run by this tool
  if (VERB === 'version' || VERB === 'bump') {
    const slug = args[1], num = args[2];
    assertGate('version', slug, num);
    die('this tool has no version-bump path: change the number in the project by hand, after the gate says yes.');
  }
  if (VERB === 'submit' || VERB === 'resubmit') {
    assertGate('submit', args[1], '');
    die('this tool never submits. Submit stays Ammaniel\'s click in App Store Connect.');
  }
  if (VERB === 'spend') { assertGate('spend', args[1], ''); die('no money-moving code exists here.'); }

  const onlySlug = VERB === 'one' ? args[1] : null;
  const wantJson = VERB === 'json';
  const targets = onlySlug ? APPS.filter((a) => a.slug === onlySlug) : APPS;
  if (onlySlug && !targets.length) die('unknown app: ' + onlySlug);

  const rows = [];
  for (const app of targets) rows.push(await readApp(app));
  const prev = safeJson(OUT_FILE);
  let apps = rows;
  if (onlySlug && prev && Array.isArray(prev.apps)) {
    apps = rows.concat(prev.apps.filter((a) => a.slug !== onlySlug));
  }
  const order = new Map(APPS.map((a, i) => [a.slug, i]));
  apps.sort((a, b) => (order.get(a.slug) ?? 99) - (order.get(b.slug) ?? 99));
  const payload = { generatedAt: new Date().toISOString(), apps };
  fs.mkdirSync(STATE, { recursive: true });
  fs.writeFileSync(OUT_FILE, JSON.stringify(payload, null, 2));
  if (wantJson) { console.log(JSON.stringify(payload, null, 2)); return; }

  logRun(prev, rows);
  const pagePath = renderPage(payload);

  console.log(`\nALL FOUR APPS — checked ${new Date().toLocaleString('en-US', { timeZone: 'America/Chicago' })} (America/Chicago)\n`);
  for (const row of rows.sort((a, b) => b.reds.length - a.reds.length)) console.log(line(row));
  console.log('');
  for (const row of rows) {
    const head = `${icon(row)} ${row.name}`;
    if (!row.reds.length && !row.notes.length) { console.log(head + ' — nothing red.'); continue; }
    console.log(head);
    for (const r of row.reds) console.log('   🔴 ' + r);
    for (const n of row.notes) console.log('   ⚪ ' + n);
  }
  const total = rows.reduce((n, r) => n + r.reds.length, 0);
  console.log(`\n${total} red${total === 1 ? '' : 's'} across ${rows.length} apps · state → ${OUT_FILE}`);
  console.log('gates → ' + (fs.existsSync(GATE_FILE) ? JSON.stringify(loadGates()) : 'none set'));
  console.log('page  → ' + pagePath);
}

main().catch((e) => die(e.message));
