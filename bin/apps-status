  .twocol{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .box{background:var(--card);border-radius:16px;padding:16px 18px;border:1px solid var(--line)}
  .box h3{font-size:17px;margin:0 0 10px;font-weight:800}
  .box ol,.box ul{margin:0;padding-left:22px;font-size:16px;font-weight:600}
  .box li{margin:6px 0}
  .log{font-size:15px;font-weight:600;color:#dde3ea}
  .log div{margin:4px 0}
  .log span{color:var(--muted);font-weight:700}
