function looksLikeImage(file) {
  try {
    const st = fs.statSync(file);
    if (st.size < 300) return false;
    const b = fs.readFileSync(file).subarray(0, 8);
    return (b[0] === 0x89 && b[1] === 0x50) || (b[0] === 0xff && b[1] === 0xd8) ||
           (b[0] === 0x47 && b[1] === 0x49) || (b[0] === 0x00 && b[1] === 0x00 && b[2] === 0x01);
  } catch { return false; }
}

function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

function readGoalFile(file) {
  try {
    if (!fs.existsSync(file)) return null;
    const t = fs.readFileSync(file, 'utf8');
    const pick = (re) => { const m = t.match(re); return m ? m[1].replace(/\*\*/g, '').trim() : null; };
    const g = { target: pick(/^\*\*Target:\*\*\s*(.+)$/m), done: pick(/^\*\*Done looks like:\*\*\s*(.+)$/m) };
    return (g.target || g.done) ? g : null;
  } catch (e) { return null; }
}

function card(p, iconHref) {
  const items = [
    ...p.reds.map(t => ['dr', 'r', t]),
    ...p.ambers.map(t => ['da', 'a', t]),
  ];
  const shown = items.slice(0, 6);
  const rest = items.length - shown.length;
  const stamp = (p.at || '').replace(/^\d{4}-\d{2}-\d{2} /, '');
  const face = iconHref
    ? `<img src="${iconHref}" alt="">`
    : `<div style="width:44px;height:44px;border-radius:11px;background:#3a4048;display:grid;place-items:center;font-weight:800;font-size:18px">${esc((p.name || '?')[0])}</div>`;
  const head = `<div class="mhead">${face}<div><div class="nm">${esc(p.name)}</div>
      <div class="ver">${esc(p.what)}</div><div class="own">owner · ${esc(p.owner)} · read ${esc(stamp || '—')}</div></div></div>`;
  const list = shown.length
    ? shown.map(([d, c, t]) => `<div class="item"><i class="dot ${d}"></i><span class="${c}">${esc(t)}</span></div>`).join('')
    : `<div class="item"><i class="dot dg"></i><span class="g">nothing missing</span></div>`;
  const more = rest > 0 ? `<p class="note">+ ${rest} more under “already in place”.</p>` : '';
  const goal = p.goal ? `<div class="goalline"><span class="gl">Goal</span>${esc(p.goal)}</div>` : '';
  const next = `<div class="nextline"><span class="nx">Next</span>${esc(p.next)}</div>`;
  const facts = p.facts.map(([k, v]) => `<div class="item"><span class="note" style="margin:0">${esc(k)}</span><span style="font-weight:700">${esc(v)}</span></div>`).join('');
  return `<div class="mlist">${head}${list}${more}${goal}${next}<p class="note">${facts}</p></div>`;
}

function renderPage(payload) {
  const props = payload.props;
  const totalRed = props.reduce((n, p) => n + p.reds.length, 0);
  const totalAmber = props.reduce((n, p) => n + p.ambers.length, 0);
  const iconHref = f => {
    const full = path.join(ICONDIR, f);
    return looksLikeImage(full) ? 'icons/' + f : '';
  };
  const green = props.map(p => `<tr><td style="font-weight:800">${esc(p.name)}</td>
      <td class="green">${p.greens.map(g => `<div>• ${esc(g)}</div>`).join('')}</td></tr>`).join('');
  const open = [].concat(...props.map(p => p.reds.map(r => [p.name, r])));
  const act = open.length ? `<div class="box"><h3>What blocks, in order</h3><ul>${open.slice(0, 8).map(([n, r]) => `<li><b style="color:#ff8078">${esc(n)}</b> — ${esc(r)}</li>`).join('')}</ul></div>`
    : `<div class="box"><h3>What blocks</h3><ul><li>Nothing — all three properties answer and hold their own.</li></ul></div>`;
  const log = (payload.changes || []).slice(-10).reverse().map(c => `<div><span>${esc(c.at)}</span> — ${esc(c.text)}</div>`).join('') || '<div><span>—</span> first run, nothing to compare yet</div>';

  return `<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<title>Projects — hintza.com · Salsa · Books</title>
<style>
${CSS}
</style></head><body><div class="wrap">
<div style="margin:0 0 20px"><a class="pagetab" href="file:///Users/nakfaai/output/apps/status.html">Apps · the four &#8594;</a></div>
<h1>Projects — hintza.com · Salsa · Books</h1>
<p class="stamp">checked ${esc(payload.lastCheck)} · <b class="count">${totalRed}</b> block · <b style="color:#ffc857">${totalAmber}</b> one thing short · ${props.length} properties · read only, nothing is written to any site</p>
<div class="bar"></div>

<h2>What is missing · ${totalRed} red · ${totalAmber} amber</h2>
<div class="grid">${props.map(p => card(p, iconHref(p.icon))).join('')}</div>

<h2>Already in place</h2>
<div class="scroll"><table><thead><tr><th>Property</th><th>Checked and true</th></tr></thead><tbody>${green}</tbody></table></div>

<h2>What blocks, in order</h2>
${act}

<h2>The books, one row each</h2>
<div class="scroll"><table><thead><tr><th>Book</th><th>Goal</th><th>Ebook files</th><th>Print PDFs</th><th>Folder</th></tr></thead><tbody>
${payload.books.rows.map(r => `<tr><td style="font-weight:800">${esc(r.name)}</td><td style="color:#a9cdf5;font-weight:700">${esc(r.goal || '—')}</td><td>${r.epub}</td><td>${r.pdf}</td><td class="green">${esc(r.dir || 'missing')}</td></tr>`).join('')}
</tbody></table></div>
<p class="note">KDP itself is not checked: Amazon gives no API for listings. The live pages on Amazon are your read, not mine.</p>

<h2>Run log — what moved</h2>
<div class="box log">${log}</div>

<h2>How this page stays true</h2>
<div class="box"><ul>
<li>One command, <b>props-status</b>, measures every line here: HTTP status, SSL days, sitemap size, forms, the git state of the Books folder.</li>
<li>The page is written from that measurement — never by hand. Run it twice a day and it cannot drift.</li>
<li>It reads only. No form is posted, no site, no KDP and no money is touched.</li>
<li>Anything it cannot measure says so, instead of guessing.</li>
</ul></div>

<p class="foot">Generated by props-status at ${esc(payload.generatedAt)} · state: ~/.dsh/state/props-status.json · log: ~/.dsh/state/props-log.md</p>
</div></body></html>`;
}

// ---------- log ----------
function diffAndLog(prev, cur) {
  const changes = (prev && prev.changes) || [];
  if (!prev) { changes.push({ at: cur.lastCheck, text: 'first run — baseline of all three properties' }); return changes; }
  for (const p of cur.props) {
    const old = (prev.props || []).find(x => x.slug === p.slug);
    if (!old) { changes.push({ at: cur.lastCheck, text: `${p.name}: first read` }); continue; }
    const gained = p.reds.filter(r => !old.reds.includes(r));
    const fixed = old.reds.filter(r => !p.reds.includes(r));
    if (gained.length) changes.push({ at: cur.lastCheck, text: `${p.name}: new red — ${gained[0]}` });
    if (fixed.length) changes.push({ at: cur.lastCheck, text: `${p.name}: fixed — ${fixed[0]}` });
  }
  // only keep today's additions distinct from history
  const stamp = cur.lastCheck;
  const fresh = changes.filter(c => c.at === stamp || !prev.changes.includes(c));
  return changes.length === (prev.changes || []).length ? changes : [...changes.filter(c => c.at !== stamp), ...fresh.filter(c => c.at === stamp)];
}

function appendLogMarkdown(changes, last) {
  const fresh = changes.filter(c => c.at === last);
  if (!fresh.length) return;
  const lines = fresh.map(c => `- ${c.at} — ${c.text}`).join('\n') + '\n';
  fs.appendFileSync(LOG, lines);
}

// ---------- icons ----------
async function ensureIcons() {
  fs.mkdirSync(ICONDIR, { recursive: true });
  const jobs = [
    ['hintza.png', HINTZA + '/favicon.ico'],
    ['hintza.png', HINTZA + '/apple-touch-icon.png'],
    ['salsa.png', SALSA + '/assets/favicon.png'],
    ['salsa.png', SALSA + '/favicon.ico'],
    ['books.png', KINGEZANA + '/favicon.ico'],
    ['books.png', KINGEZANA + '/apple-touch-icon.png'],
  ];
  for (const [file, url] of jobs) {
    const dest = path.join(ICONDIR, file);
    if (fs.existsSync(dest) && fs.statSync(dest).size > 500) continue;
    try {
      const r = await fetch(url, { signal: AbortSignal.timeout(10000), redirect: 'follow' });
      if (!r.ok) continue;
      const buf = Buffer.from(await r.arrayBuffer());
      const type = r.headers.get('content-type') || '';
      if (buf.length < 500) continue;
      if (!/image/.test(type) && !url.endsWith('.ico')) continue;
      if (url.endsWith('.ico')) {
        // Safari and Chromium both accept ico in <img>; keep it as-is
      }
      fs.writeFileSync(dest, buf);
      if (!looksLikeImage(dest)) fs.rmSync(dest, { force: true });
    } catch { /* keep going */ }
  }
}

// ---------- main ----------
async function main() {
  const cmd = process.argv[2] || 'run';
  if (cmd === 'open') { spawnSync('open', ['/Users/nakfaai/output/projects/status.html']); return; }
  if (cmd === 'page') {
    const p = JSON.parse(fs.readFileSync(STATE, 'utf8'));
    fs.mkdirSync(OUTDIR, { recursive: true });
    fs.writeFileSync(path.join(OUTDIR, 'status.html'), renderPage(p));
    console.log('page → /Users/nakfaai/output/projects/status.html (from state ' + p.generatedAt + ')');
    return;
  }
  if (cmd === 'json') {
    const prev = fs.existsSync(STATE) ? JSON.parse(fs.readFileSync(STATE, 'utf8')) : null;
    const { props, books } = await collect();
    const payload = { generatedAt: new Date().toISOString(), lastCheck: now(), props, books, changes: prev ? prev.changes || [] : [] };
    console.log(JSON.stringify(payload, null, 2));
    return;
  }

  await ensureIcons();
  const prev = fs.existsSync(STATE) ? JSON.parse(fs.readFileSync(STATE, 'utf8')) : null;
  const got = await collect();
  const books = got.books;
  const props = got.props.map(p => mergeBlocked(p, prev));
  const lastCheck = now();
  const payload = { generatedAt: new Date().toISOString(), lastCheck, props, books, changes: [] };
  payload.changes = diffAndLog(prev, payload);
  fs.mkdirSync(path.dirname(STATE), { recursive: true });
  fs.writeFileSync(STATE, JSON.stringify(payload, null, 2));
  appendLogMarkdown(payload.changes, lastCheck);
  fs.mkdirSync(OUTDIR, { recursive: true });
  fs.writeFileSync(path.join(OUTDIR, 'status.html'), renderPage(payload));

  const reds = props.reduce((n, p) => n + p.reds.length, 0);
  const ambers = props.reduce((n, p) => n + p.ambers.length, 0);
  console.log(`checked ${props.length} properties at ${lastCheck} — ${reds} red, ${ambers} amber`);
  for (const p of props) console.log(`  ${p.reds.length ? '✗' : '✓'} ${p.name.padEnd(22)} ${p.reds.length} red, ${p.ambers.length} amber — ${p.next}`);
  console.log('page → /Users/nakfaai/output/projects/status.html');
}

main().catch(e => { console.error('props-status failed:', e && e.stack || e); process.exit(1); });
