JS = """
(function(){
 var q=document.getElementById('q'), chips=[].slice.call(document.querySelectorAll('.chip')),
     items=[].slice.call(document.querySelectorAll('[data-kind]')), empty=document.getElementById('empty'),
     kind='picture';
 function apply(){
   var t=q.value.trim().toLowerCase(), shown=0;
   items.forEach(function(el){
     var okKind = (kind==='all') || (el.dataset.kind===kind) ||
                  (kind==='document' && el.dataset.kind==='log');
     var hay=(el.dataset.name+' '+el.dataset.folder).toLowerCase();
     var okText=t===''||hay.indexOf(t)>=0;
     var on=okKind&&okText; el.style.display=on?'':'none'; if(on)shown++;
   });
   chips.forEach(function(c){c.classList.toggle('on',c.dataset.kind===kind)});
   empty.style.display=shown?'none':'block';
 }
 chips.forEach(function(c){c.addEventListener('click',function(){kind=c.dataset.kind;apply()})});
 q.addEventListener('input',apply);
 apply();

 // 📁 button -> local helper opens Finder at that file or folder.
 var REVEAL='http://127.0.0.1:7799/reveal?p=';
 document.addEventListener('click',function(ev){
   var b=ev.target.closest?ev.target.closest('.pick'):null;
   if(!b)return;
   ev.preventDefault(); ev.stopPropagation();
   var p=b.dataset.path;
   if(!p){b.title='No path on this item';return;}
   var probe=new Image();
   probe.onload=probe.onerror=function(){
     b.classList.add('done');
     b.textContent='✓';
     setTimeout(function(){b.classList.remove('done');b.textContent='📁'},1200);
   };
   probe.src=REVEAL+encodeURIComponent(p)+'&t='+Date.now();
 });
})();
"""


def render(rows, root):
    by_kind = {"picture": 0, "video": 0, "document": 0, "data": 0, "log": 0, "other": 0}
    for r in rows:
        by_kind[r["kind"]] = by_kind.get(r["kind"], 0) + 1
    total_size = sum(r["size"] for r in rows)
    newest = rows[0]["mtime"] if rows else time.time()

    out = []
    out.append("<!doctype html>")
    out.append('<html lang="en"><head><meta charset="utf-8">')
    out.append('<meta name="viewport" content="width=device-width,initial-scale=1">')
    out.append('<title>Every file the Bots made</title><style>%s</style></head>' % CSS)
    out.append("<body><header>")
    out.append("<h1>Every file the Bots made</h1>")
    out.append('<div class="sub">%d files &middot; %s &middot; newest %s &middot; '
               'rebuilt %s</div>' % (
                   len(rows), human_size(total_size),
                   time.strftime("%a %d %b, %H:%M", time.localtime(newest)),
                   time.strftime("%a %d %b %Y, %H:%M", time.localtime())))
    out.append('<input id="q" class="search" type="search" '
               'placeholder="Search a name or a folder...">')
    out.append('<div class="chips">')
    chips = [("picture", "Pictures (%d)" % by_kind["picture"]),
             ("document", "Documents (%d)" % (by_kind["document"] + by_kind["log"])),
             ("video", "Video (%d)" % by_kind["video"]),
             ("data", "Data (%d)" % by_kind["data"]),
             ("all", "Everything (%d)" % len(rows))]
    for key, label in chips:
        out.append('<button class="chip" data-kind="%s">%s</button>' % (key, html.escape(label)))
    out.append("</div>")

    # One chip per folder: the name opens the folder in Safari, 📁 opens Finder.
    folders = {}
    for r in rows:
        folders.setdefault(r["folder"], r["dir"])
    out.append("</header>")

    # Folders sit in their own panel on the right, so they never cover the page.
    if folders:
        out.append('<aside class="side"><h2>Folders</h2><div class="folders">')
        for name in sorted(folders, key=str.lower):
            furi = "file://" + urllib.parse.quote(folders[name], safe="/") + "/"
            out.append('<span class="fl"><a href="%s" target="_blank" rel="noopener">%s</a>'
                       '<button class="pick" type="button" title="Show this folder in Finder" '
                       'data-path="%s">&#128193;</button></span>' % (
                           html.escape(furi, quote=True), html.escape(name),
                           html.escape(folders[name], quote=True)))
        out.append("</div></aside>")

    out.append("<main>")

    def href(r):
        return "file://" + urllib.parse.quote(r["abs"], safe="/")

    for kind in ("picture", "video", "document", "data", "log", "other"):
        group = [r for r in rows if r["kind"] == kind]
        if not group:
            continue
        out.append("<h2>%s &middot; %d</h2>" % (KIND_LABEL[kind], len(group)))
        if kind in ("picture", "video"):
            out.append('<div class="grid">')
            for r in group:
                caption = ("%s &middot; %s" % (html.escape(r["folder"]), human_size(r["size"])))
                if r["bot"]:
                    caption += " &middot; " + html.escape(r["bot"])
                out.append(
                    '<figure data-kind="%s" data-name="%s" data-folder="%s">'
                    '<button class="pick" type="button" title="Show in Finder" data-path="%s">'
                    '&#128193;</button>'
                    '<a class="open" href="%s" target="_blank" rel="noopener">'
                    '<img loading="lazy" src="%s" alt="%s"></a>'
                    '<figcaption><b>%s</b><span>%s</span></figcaption></figure>' % (
                        r["kind"], html.escape(r["name"]), html.escape(r["folder"]),
                        html.escape(r["abs"], quote=True), html.escape(href(r), quote=True),
                        urllib.parse.quote(r["rel"], safe="/"), html.escape(r["name"]),
                        html.escape(r["title"]), caption))
            out.append("</div>")
        else:
            for r in group:
                when = time.strftime("%d %b %H:%M", time.localtime(r["mtime"]))
                out.append(
                    '<div class="row" data-kind="%s" data-name="%s" data-folder="%s">'
                    '<span class="badge">%s</span>'
                    '<a href="%s" target="_blank" rel="noopener" style="text-decoration:none;color:inherit">'
                    '<span class="nm">%s</span></a>'
                    '<span class="mt">%s &middot; %s</span>'
                    '<button class="pick" type="button" title="Show in Finder" data-path="%s">'
                    '&#128193;</button></div>' % (
                        r["kind"], html.escape(r["name"]), html.escape(r["folder"]),
                        html.escape(r["ext"] or "file"),
                        html.escape(href(r), quote=True), html.escape(r["title"]),
                        html.escape(when), human_size(r["size"]),
                        html.escape(r["abs"], quote=True)))
        out.append('<p id="empty" class="empty" style="display:none">'
                   'Nothing here for this filter.</p>')

    out.append("</main><footer>Built in %s by <code>~/.dsh/bin/outputs</code>. "
               "A Bot copies each file here, so the sidebar link opens.</footer>" % html.escape(root))
    out.append("<script>%s</script></body></html>" % JS)
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--open", action="store_true")
    ap.add_argument("--root", default=ROOT_DEFAULT)
    ap.add_argument("--quiet", action="store_true")
    a = ap.parse_args()

    root = os.path.abspath(a.root)
    if not os.path.isdir(root):
        sys.stderr.write("no such folder: %s\n" % root)
        return 2

    rows = collect(root)
    page = render(rows, root)
    target = os.path.join(root, INDEX_NAME)
    tmp = target + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(page)
    os.replace(tmp, target)

    if not a.quiet:
        print("indexed %d files -> %s (%d bytes)" % (len(rows), target, len(page.encode())))
    if a.open:
        subprocess.call(["open", "-a", "Safari", target])
    return 0


if __name__ == "__main__":
    sys.exit(main())
