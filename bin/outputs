#!/usr/bin/env python3
"""Build one local page listing every file the Bots delivered.

Usage: outputs [--open] [--root DIR] [--quiet]

Scans ROOT (default /Users/nakfaai/output), newest first, and writes
ROOT/index.html: a self-contained page with search, filter chips and
picture previews taken straight from the existing files.

Nothing is installed, nothing is copied, no server, no internet.
A LaunchAgent (com.nakfaai.output-index) runs this every 5 minutes.
"""
import argparse
import html
import json
import os
import subprocess
import sys
import time
import urllib.parse

ROOT_DEFAULT = "/Users/nakfaai/output"
INDEX_NAME = "index.html"
SKIP_DIRS = {".thumbs", ".git", "node_modules"}
IMAGE_EXT = {"png", "jpg", "jpeg", "gif", "webp", "bmp", "heic", "svg"}
VIDEO_EXT = {"mp4", "mov", "m4v", "webm"}
DOC_EXT = {"pdf", "docx", "xlsx", "pptx", "doc", "xls", "ppt", "pages"}
DATA_EXT = {"json", "yml", "yaml", "csv", "xml"}
LOG_EXT = {"log", "txt", "md"}

KIND_LABEL = {
    "picture": "Pictures",
    "video": "Video",
    "document": "Documents",
    "data": "Data",
    "log": "Notes & logs",
    "other": "Everything",
}


def kind_of(ext):
    if ext in IMAGE_EXT:
        return "picture"
    if ext in VIDEO_EXT:
        return "video"
    if ext in DOC_EXT:
        return "document"
    if ext in DATA_EXT:
        return "data"
    if ext in LOG_EXT:
        return "log"
    return "other"


def human_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024.0
    return "%d B" % n


def load_folder_titles(folder_path):
    """Optional .index.json in a folder: {"file.png": {"title": "...", "bot": "..."}}"""
    p = os.path.join(folder_path, ".index.json")
    if not os.path.isfile(p):
        return {}
    try:
        with open(p, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def collect(root):
    rows = []
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = sorted(d for d in dirnames if not d.startswith(".") and d not in SKIP_DIRS)
        titles = load_folder_titles(dirpath)
        for name in filenames:
            if name.startswith("."):
                continue
            full = os.path.join(dirpath, name)
            if os.path.islink(full) or not os.path.isfile(full):
                continue
            if os.path.abspath(full) == os.path.abspath(os.path.join(root, INDEX_NAME)):
                continue
            rel = os.path.relpath(full, root)
            ext = os.path.splitext(name)[1].lstrip(".").lower()
            try:
                st = os.stat(full)
            except OSError:
                continue
            parts = rel.split(os.sep)
            folder = parts[0] if len(parts) > 1 else "root"
            meta = titles.get(name) or {}
            rows.append({
                "rel": rel,
                "abs": os.path.abspath(full),
                "dir": dirpath,
                "name": name,
                "folder": folder,
                "title": meta.get("title") or os.path.splitext(name)[0],
                "bot": meta.get("bot") or "",
                "kind": kind_of(ext),
                "ext": ext,
                "size": st.st_size,
                "mtime": st.st_mtime,
            })
    rows.sort(key=lambda r: r["mtime"], reverse=True)
    return rows


CSS = """
:root{--ink:#111;--soft:#6b6b6b;--line:#e6e6e6;--bg:#fffdf8;--hi:#fff0d6;}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
 font:16px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif}
header{position:sticky;top:0;z-index:5;background:var(--bg);
 border-bottom:1px solid var(--line);padding:18px 22px 12px}
h1{margin:0 0 2px;font-size:24px;font-weight:700;letter-spacing:-.2px}
.sub{color:var(--soft);font-size:13px;margin-bottom:14px}
.search{width:100%;max-width:520px;padding:11px 14px;font-size:16px;
 border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink);outline:none}
.search:focus{border-color:#bbb}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.chip{border:1px solid var(--line);background:#fff;color:var(--ink);padding:7px 13px;
 border-radius:999px;font-size:14px;cursor:pointer}
.chip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
main{padding:20px 22px 60px}
h2{font-size:13px;text-transform:uppercase;letter-spacing:.12em;color:var(--soft);
 margin:26px 0 12px;font-weight:600}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(380px,1fr));gap:18px}
figure{margin:0;background:#fff;border:1px solid var(--line);border-radius:14px;
 overflow:hidden;cursor:pointer}
