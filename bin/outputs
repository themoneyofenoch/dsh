figcaption{padding:9px 11px 11px;font-size:13px}
figcaption b{display:block;font-weight:600;white-space:nowrap;overflow:hidden;
 text-overflow:ellipsis}
figcaption span{color:var(--soft);font-size:12px}
.row{display:flex;align-items:baseline;gap:12px;padding:11px 12px;background:#fff;
 border:1px solid var(--line);border-radius:12px;margin-bottom:8px;cursor:pointer}
.row:hover{border-color:#ccc}
.row .badge{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--soft);
 min-width:74px}
.row .nm{font-weight:600;word-break:break-all}
.row .mt{color:var(--soft);font-size:12px;margin-left:auto;white-space:nowrap}
.pick{font:inherit;font-size:15px;line-height:1;border:1px solid var(--line);background:#fff;
 color:var(--ink);border-radius:9px;padding:6px 8px;cursor:pointer}
.pick:hover{border-color:#bbb;background:var(--hi)}
.pick.done{background:#e8f8ef;border-color:#9ad9b4}
