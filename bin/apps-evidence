            "shots/ipad-2064x2752", "shots/share"]


def esc(s):
    return html.escape(str(s), quote=True)


def inline(s):
    s = esc(s)
    s = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", s)
    s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
    return s


def render_table(rows):
    grid = []
    for r in rows:
        cells = [c.strip() for c in r.strip().strip("|").split("|")]
        if cells and all(re.fullmatch(r":?-{2,}:?", c or "") for c in cells):
            continue
        grid.append(cells)
    if not grid:
        return ""
    head, body = grid[0], grid[1:]
    out = ['<table class="md"><thead><tr>']
    out += ["<th>%s</th>" % inline(c) for c in head]
    out.append("</tr></thead><tbody>")
    for row in body:
        out.append("<tr>" + "".join("<td>%s</td>" % inline(c) for c in row) + "</tr>")
    out.append("</tbody></table>")
    return "".join(out)


def render_md(body):
    lines = body.splitlines()
    out, i, n = [], 0, len(lines)
    while i < n:
        s = lines[i].strip()
        if not s:
            i += 1
            continue
        if s.startswith("|") and s.endswith("|"):
            rows = []
            while i < n and lines[i].strip().startswith("|"):
                rows.append(lines[i].strip())
                i += 1
            out.append(render_table(rows))
            continue
        if s.startswith("### "):
            out.append("<h5>%s</h5>" % inline(s[4:]))
        elif s.startswith("## "):
            out.append("<h4>%s</h4>" % inline(s[3:]))
        elif s.startswith("# "):
            out.append("<h3>%s</h3>" % inline(s[2:]))
        elif s in ("---", "***", "___"):
            out.append("<hr>")
        elif s.startswith(("- ", "* ")):
            items = []
            while i < n and lines[i].strip().startswith(("- ", "* ")):
                items.append(inline(lines[i].strip()[2:]))
                i += 1
            out.append("<ul>" + "".join("<li>%s</li>" % x for x in items) + "</ul>")
            continue
        elif re.match(r"^\d+[.)]\s+", s):
            items = []
            while i < n and re.match(r"^\d+[.)]\s+", lines[i].strip()):
                items.append(inline(re.sub(r"^\d+[.)]\s+", "", lines[i].strip())))
                i += 1
            out.append("<ol>" + "".join("<li>%s</li>" % x for x in items) + "</ol>")
            continue
        else:
            out.append("<p>%s</p>" % inline(s))
        i += 1
    return "\n".join(out)


def load_json(p, default):
    try:
        with open(p, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def status_md(slug):
    p = os.path.join(EVID, slug, "STATUS.md")
    if not os.path.isfile(p):
        return None, None
    with open(p, encoding="utf-8") as f:
        body = f.read()
    return body, datetime.fromtimestamp(os.path.getmtime(p)).strftime("%Y-%m-%d %H:%M")


def img_size(path):
    """(width, height) read straight from the file header; (0, 0) when unknown."""
    try:
        with open(path, "rb") as f:
            head = f.read(26)
            if head[:8] == b"\x89PNG\r\n\x1a\n":
                return struct.unpack(">II", head[16:24])
            if head[:2] == b"\xff\xd8":
                f.seek(2)
                while True:
                    b = f.read(1)
                    if not b:
                        break
                    if b != b"\xff":
                        continue
                    m = f.read(1)
                    while m == b"\xff":
                        m = f.read(1)
                    if m[0] in (0xD8, 0xD9) or not m:
                        continue
                    ln = int.from_bytes(f.read(2), "big")
                    if 0xC0 <= m[0] <= 0xCF and m[0] not in (0xC4, 0xC8, 0xCC):
                        d = f.read(5)
                        return int.from_bytes(d[3:5], "big"), int.from_bytes(d[1:3], "big")
                    f.seek(ln - 2, 1)
    except Exception:
        pass
    return (0, 0)


ART_RE = re.compile(r"(icon|feature[-_ ]?graphic|feature|banner)", re.I)


def _label_of(key):
    seg = key.split("/")[-1] if key else "shots"
    for k in (key, seg):
        if k in SET_LABEL:
            return SET_LABEL[k]
    if seg in ("shots", ""):
        return ("Screenshots", "")
    return (seg.replace("-", " ").replace("_", " ").title(), "")


def _rank_of(key):
    seg = key.split("/")[-1] if key else ""
    for k in (key, seg):
        if k in DIR_RANK:
            return DIR_RANK.index(k)
    for pre, r in (("apple", 2), ("fresh", 3), ("play-fresh", 4), ("play", 5),
                   ("iphone", 8), ("ipad", 9), ("share", 10)):
        if seg.startswith(pre):
            return r
    return 50


THUMB_DIR = "/Users/nakfaai/output/apps/evidence/_thumbs"

LABEL_ORDER = ["iPhone 6.9", "iPhone 6.7", "iPhone 6.5", "iPhone 6.1", "iPhone 4.7",
               "iPad 13", "iPad 12.9 · 2048", "iPad 12.9", "iPad 11"]


def _lab_rank(label):
    for i, pre in enumerate(LABEL_ORDER):
        if label.startswith(pre):
            return i
    return 50


def thumb_abs(path, slug):
    """Small JPEG twin of a screenshot, cached by size+mtime. None if unreadable."""
    try:
        st = os.stat(path)
    except OSError:
        return None
    rel = os.path.relpath(path, os.path.join(EVID, slug))
    key = re.sub(r"[^A-Za-z0-9]+", "_", rel).strip("_")[:120]
    key = "%s-%d-%d" % (key, st.st_size, int(st.st_mtime))
    out = os.path.join(THUMB_DIR, slug, key + ".jpg")
    if os.path.exists(out) and os.path.getmtime(out) >= st.st_mtime:
        return out
    try:
        os.makedirs(os.path.dirname(out), exist_ok=True)
        from PIL import Image
        im = Image.open(path).convert("RGB")
        im.thumbnail((330, 700), Image.LANCZOS)
        im.save(out, "JPEG", quality=82, optimize=True)
        return out
    except Exception:
        return None


def _finish(sets):
    """Sort, split store art from screenshots, and measure each set."""
    out = []
    art_all = []
    for st in sets:
        art = [n for n in st["files"] if ART_RE.search(n)]
        shots = [n for n in st["files"] if not ART_RE.search(n)]
        art_all.extend((st["rel"], n) for n in art)
        if shots:
            out.append(dict(st, files=shots))
    if art_all:
        out.append({"slug": sets[0]["slug"] if sets else "", "rel": "",
                    "label": "Store art · icon and feature graphic", "note": "",
                    "files": [n for _r, n in art_all], "rank": 90,
                    "rels": [r for r, _n in art_all]})
    for st in out:
        rels = st.get("rels") or [st["rel"]] * len(st["files"])
        paths = [os.path.join(EVID, st["slug"], r, n) if r
                 else os.path.join(EVID, st["slug"], n) for r, n in zip(rels, st["files"][:3])]
        sizes = [img_size(p) for p in paths]
        sizes = [(w, h) for w, h in sizes if w and h]
        st["wide"] = bool(sizes) and sum(1 for w, h in sizes if w > h) > len(sizes) / 2
        st["caption"] = (st["files"][0].rsplit("-", 1)[0] + "-" if len(st["files"]) > 1 and
                         re.match(r"^([A-Z0-9_]{3,})-\d+\.", st["files"][0]) else "")
    out.sort(key=lambda s: (s["rank"], _lab_rank(s["label"]), s["label"]))
    return out


CAND_REL = "shots/candidates"
PICK_MAX = 10


def pick_files(slug):
    """The 24 candidates the app's Bot shot — the pictures Ammaniel ticks his 10 from."""
    d = os.path.join(EVID, slug, CAND_REL)
    if not os.path.isdir(d):
        return []
    return [n for n in sorted(os.listdir(d))
            if IMG_RE.search(n) and not n.startswith(("_", "t-"))]


def pick_num(n, i):
    m = re.match(r"^(\d{1,2})[-_.]", n)
    return int(m.group(1)) if m else i + 1


def picks_html(apps):
    """The tap-to-tick grid: every candidate on the page, his 10 kept in the order he taps."""
    groups, total = [], 0
    for a in apps:
        slug = a.get("slug") or ""
        name = a.get("name") or slug
        files = pick_files(slug)
        total += len(files)
        if not files:
            groups.append(
                '<div class="pickapp" data-app="%s" id="pick-%s"><div class="pickhead"><b>%s</b>'
                '<span class="picks-note">no candidates on disk yet</span></div></div>'
                % (esc(slug), esc(slug), esc(name)))
            continue
        cards = []
        for i, n in enumerate(files):
            rel = "evidence/%s/%s/%s" % (slug, CAND_REL, n)
            full = os.path.join(EVID, slug, CAND_REL, n)
            t = thumb_abs(full, slug)
            src = os.path.relpath(t, os.path.dirname(OUT)) if t else rel
            short = re.sub(r"^\d{1,2}[-_.]", "", n).rsplit(".", 1)[0].replace("-", " ")
            cards.append(
                '<div class="pcard" role="checkbox" aria-checked="false" tabindex="0" '
                'data-app="%s" data-file="%s" title="%s">'
                '<span class="tick">&#10003;</span>'
                '<img decoding="async" loading="lazy" src="%s" alt="%s">'
                '<div class="pmeta"><b>%d</b><span class="pname">%s</span>'
                '<a class="open" href="%s" target="_blank" rel="noopener">&#8599;</a></div></div>'
                % (esc(slug), esc(n), esc(n), esc(src), esc(n), pick_num(n, i), esc(short), esc(rel)))
        note = ""
        if len(files) < PICK_MAX:
            note = '<span class="picks-note">%d on disk &mdash; %s Bot still shooting</span>' % (
                len(files), esc(name))
        groups.append(
            '<div class="pickapp" data-app="%s" id="pick-%s">'
            '<div class="pickhead"><b>%s</b><span class="pickcount">0 of %d picked</span>%s</div>'
            '<div class="pickgrid">%s</div></div>'
            % (esc(slug), esc(slug), esc(name), PICK_MAX, note, "".join(cards)))
    if not groups:
        return ""
    return ('<section class="picks" id="picks"><h2>Screenshots &mdash; tap your 10'
            '<span class="cnt" id="picktotal">0 of %d ticked</span></h2>'
            '<p class="picks-lead">Tap a picture to tick it, tap again to drop it. '
            'The order you tap is the order they go into the store; Apple takes 10 and Play takes the '
            'first 8. Each tap saves as you go. &#8599; opens one full size.</p>%s</section>'
            % (total, "".join(groups)))


def image_sets(slug):
    """Every folder of screenshots under the app's evidence dir, as named sets."""
    root = os.path.join(EVID, slug)
    if not os.path.isdir(root):
        return []
    found = []
    for cur, _dirs, files in os.walk(root):
        if os.path.relpath(cur, root).replace(os.sep, "/").endswith(CAND_REL):
            continue
        imgs = sorted(n for n in files if IMG_RE.search(n))
        if not imgs:
            continue
        rel = os.path.relpath(cur, root).replace(os.sep, "/")
        rel = "" if rel == "." else rel
        key = rel or "shots"
        label, note = _label_of(key)
        rank = _rank_of(key)
        pref = re.match(r"^([A-Z0-9_]{3,})-\d+\.(png|jpe?g)$", imgs[0], re.I)
        if pref and all(re.match(r"^([A-Z0-9_]{3,})-\d+\.(png|jpe?g)$", n, re.I) for n in imgs):
            by = {}
            for n in imgs:
                by.setdefault(re.match(r"^([A-Z0-9_]{3,})-\d+\.", n, re.I).group(1), []).append(n)
            for p, names in by.items():
                found.append({"slug": slug, "rel": rel, "label": DTYPE.get(p, label + " · " + p),
                              "note": "", "files": names, "rank": rank})
            continue
        found.append({"slug": slug, "rel": rel, "label": label, "note": note,
                      "files": imgs, "rank": rank})
    return _finish(found)


def shots_html(slug):
    sets = image_sets(slug)
    if not sets:
        return ('<p class="empty">⚪ No screenshots in the evidence folder yet — '
                '<code>%s/%s/</code> holds only a report.</p>' % (EVID, slug))
    blocks = []
    for st in sets:
        thumbs = []
        pref = st.get("caption") or ""
        rels = st.get("rels") or [st["rel"]] * len(st["files"])
        for n, r in zip(st["files"], rels):
            rel = "evidence/%s/%s" % (slug, (r + "/" + n) if r else n)
            full = os.path.join(EVID, slug, r, n) if r else os.path.join(EVID, slug, n)
            t = thumb_abs(full, slug)
            src = (os.path.relpath(t, os.path.dirname(OUT)) if t else rel)
            cap = n[len(pref):].rsplit(".", 1)[0] if pref and n.startswith(pref) else n.rsplit(".", 1)[0]
            thumbs.append(
                '<a class="shot" href="%s" target="_blank" title="%s"><img decoding="async" src="%s" alt="%s">'
                '<span>%s</span></a>' % (esc(rel), esc(n), esc(src), esc(n), esc(cap)))
        more = ""
        if len(st["files"]) > 8:
            links = "".join(
                '<li><a href="%s" target="_blank">%s</a></li>' % (
                    esc("evidence/%s/%s" % (slug, (r + "/" + n) if r else n)), esc(n))
                for n, r in zip(st["files"], rels))
            more = ('<details class="files"><summary>All %d files</summary><ul>%s</ul></details>'
                    % (len(st["files"]), links))
        note = (' <em>%s</em>' % esc(st["note"])) if st["note"] else ""
        blocks.append(
            '<div class="set"><div class="sethead"><b>%s</b>%s<span>%d %s</span></div>'
            '<div class="strip%s">%s</div>%s</div>'
            % (esc(st["label"]), note, len(st["files"]), "shot" if len(st["files"]) == 1 else "shots",
               " wide" if st["wide"] else "", "".join(thumbs), more))
    return "".join(blocks)


def tile(label, value, lines, cls=""):
    sub = "".join("<span>%s</span>" % x for x in lines if x)
    return ('<div class="tile %s"><div class="tl">%s</div><div class="tv">%s</div>%s</div>'
            % (cls, esc(label), value, sub))


def track_bits(play):
    tracks = play.get("tracks") or {}
    bits, reds = [], []
    for t in ("production", "beta", "alpha", "internal"):
        tr = tracks.get(t)
        if not tr:
            bits.append('<span class="m">%s empty</span>' % t)
            if t in ("production", "beta"):
                reds.append("")
        else:
            vc = ",".join(tr.get("versionCodes") or [])
            bits.append('%s vc %s <span class="m">%s</span>' % (t, esc(vc), esc(tr.get("status"))))
    return bits, reds


SRC_WORDS = ("Apple", "Play", "GitHub", "Xcode Cloud", "Google Play", "App Store")


def missing_li(m):
    """One red, with its source as a small badge and Apple's keys said in plain words."""
    for k, v in SHORT_SIZE.items():
        m = m.replace(k, v)
    m = re.sub(r"\b1 files\b", "1 file", m)
    if ": " in m:
        src, rest = m.split(": ", 1)
        if src in SRC_WORDS:
            return '<li><span class="dot dr"></span><span><b class="src">%s</b>%s</span></li>' % (
                esc(src), inline(rest))
    return '<li><span class="dot dr"></span>%s</li>' % inline(m)


def missing_of(app):
    """Every red the store/git/Xcode-Cloud reads measured, in one plain list."""
    apple = app.get("apple") or {}
    ci = apple.get("ci") or {}
    play = app.get("play") or {}
    repo = app.get("repo") or {}
    out = []
    for src in (apple, ci, play, repo):
        for r in (src.get("reds") or []):
            if r not in out:
                out.append(r)
    for r in (app.get("reds") or []):
        tail = r.split(":", 1)[-1].strip()
        if r in out:
            continue
        if any(tail and tail in x for x in out):
            continue
        out.append(r)
    for note in (apple.get("notes") or []):
        if note.startswith(("no iPad", "thin screenshots")) and note not in out:
            out.append("Apple: " + note)
    return out


KIND_LABEL = {"clear": "Clear", "gray": "Grey"}


def answered(rec):
    """A saved answer as a chip, or the two buttons when it is still open."""
    if not rec:
        return ('<button class="y" data-v="yes">Yes</button>'
                '<button class="h" data-v="hold">Hold</button>')
    when = esc((rec.get("at") or "")[11:16])
    if (rec.get("answer") or "").lower() == "yes":
        return '<span class="saved">✅ yes · %s</span>' % when
    return '<span class="saved hold">🟡 hold · %s</span>' % when


def norm_steps(wait):
    """Pending steps as dicts: step/kind/pick/why. A plain string is clear + yes."""
    out = []
    for w in (wait or []):
        if isinstance(w, str):
            out.append({"step": w, "kind": "clear", "pick": "yes", "why": ""})
        elif isinstance(w, dict):
            out.append({"step": w.get("step") or "", "kind": (w.get("kind") or "clear").lower(),
                        "pick": (w.get("pick") or "yes").lower(), "why": w.get("why") or ""})
    return out


def app_card(app, pending):
    slug = app.get("slug")
    name = app.get("name") or slug
    bot = OWNER.get(slug, "its own Bot")
    play = app.get("play") or {}
    apple = app.get("apple") or {}
    repo = app.get("repo") or {}
    ci = apple.get("ci") or {}
    cur = apple.get("current") or {}
    build = cur.get("build") or {}
    nb = apple.get("newestBuild")
    nb_ver = str(nb) if isinstance(nb, (int, str)) and str(nb) not in ("", "None") else ""
    body, when = status_md(slug)

    # ---------- missing: every red the state JSON measured, section by section
    missing = missing_of(app)
    missing_html = ("".join(missing_li(m) for m in missing)
                    or '<li class="clear"><span class="dot dg"></span>Nothing missing on either store.</li>')

    # ---------- waiting on him
    wait = norm_steps(pending)
    wait_html = ("".join('<li><span class="num">%d</span>%s</li>' % (i + 1, inline(w["step"]))
                         for i, w in enumerate(wait))
                 or '<li class="clear"><span class="dot dg"></span>Nothing waiting on you.</li>')

    # ---------- next action
    if wait:
        nxt = ""
        nxt_cls = ""
    elif str(cur.get("state") or "") in ("WAITING_FOR_REVIEW", "IN_REVIEW"):
        nxt = "⏳ In Apple's review — nothing needed from you"
        nxt_cls = "blue"
    elif apple.get("live"):
        nxt = "✅ Live on the store — nothing needed from you"
        nxt_cls = "green"
    else:
        nxt = "✅ Nothing needed from you"
        nxt_cls = "green"

    # ---------- tiles
    a_state = esc(cur.get("state") or "no version")
    a_val = '%s <span class="m">%s</span>' % (esc(cur.get("version") or "—"), a_state)
    a_lines = []
    if build:
        a_lines.append("build %s attached · %s" % (esc(build.get("version") or "?"), esc(build.get("state") or "")))
    else:
        a_lines.append("no build attached")
    if nb_ver and nb_ver != str(build.get("version") or ""):
        a_lines.append("newest uploaded build %s" % esc(nb_ver))
    if apple.get("live"):
        a_lines.append("live %s build %s" % (esc(apple["live"].get("version")), esc(apple["live"].get("build"))))
    shots_d = apple.get("shots") or {}
    if shots_d:
        total = sum(shots_d.values())
        thin = [(k, v) for k, v in shots_d.items() if v < 3]
        line = "shots %d in %d size%s" % (total, len(shots_d), "" if len(shots_d) == 1 else "s")
        if thin:
            line += " · thin: " + ", ".join("%s %d" % (SHORT_SIZE.get(k, k), v) for k, v in thin)
        a_lines.append(line)
    else:
        a_lines.append("no screenshot sets")
    a_cls = "red" if (not build or shots_d.get("APP_IPAD_PRO_129", 1) == 0 or shots_d.get("APP_IPAD_PRO_3GEN_129", 1) == 0) else ""

    tracks = play.get("tracks") or {}
    prod = tracks.get("production") or {}
    if prod and (prod.get("versionCodes") or []):
        p_val = "live vc %s" % esc(",".join(prod["versionCodes"]))
        p_cls = ""
    else:
        p_val = '<span class="m">production</span> empty'
        p_cls = "red"
    closed = []
    for t in ("alpha", "internal"):
        tr = tracks.get(t)
        if tr:
            closed.append("%s vc %s <span class=\"m\">%s</span>"
                          % (t, esc(",".join(tr.get("versionCodes") or [])), esc(tr.get("status") or "")))
    p_lines = closed if closed else ["no testing track"]
    imgs = play.get("playImages") or {}
    if imgs:
        want = (("phoneScreenshots", "phone"), ("icon", "icon"), ("featureGraphic", "feature graphic"))
        p_lines.append("images " + " · ".join("%s %s" % (lab, imgs.get(k, 0)) for k, lab in want))
        if not imgs.get("phoneScreenshots") or not imgs.get("icon"):
            p_cls = "red"
    else:
        p_lines.append("images not read")

    b_val = '<span class="m">newest build</span> %s' % esc(nb_ver or "—")
    b_lines = []
    if ci.get("run"):
        run = ci["run"]
        ok = run.get("status") == "SUCCEEDED"
        b_lines.append("Xcode Cloud #%s %s" % (esc(run.get("number")), esc(run.get("status"))))
        b_cls = "" if ok else "red"
        b_val = '<span class="m">newest build</span> %s' % esc(nb_ver or "—")
    else:
        b_lines.append("Xcode Cloud not read")
        b_cls = ""

    dirty = repo.get("dirty")
    r_val = "%s <span class=\"m\">@ %s</span>" % (esc(repo.get("branch") or "—"), esc(repo.get("head") or ""))
    r_lines = ["%s file%s to commit" % (esc(dirty), "" if dirty == 1 else "s") if dirty else "clean tree"]
    r_cls = "red" if dirty else ""

    facts = (tile("App Store", a_val, a_lines, a_cls) +
             tile("Google Play", "", p_lines, p_cls) +
             tile("Build train", b_val, b_lines, b_cls) +
             tile("GitHub", r_val, r_lines, r_cls))

    notes = [n for n in (app.get("notes") or []) if "not checked" in n]
    notes_html = ("".join('<span class="nc">Not checked yet: %s</span>'
                          % esc(n.split(":", 1)[0].strip()) for n in notes))

    if body:
        report = ('<details class="report"><summary>Full report — written %s by %s '
                  '<span class="hint">opens the raw evidence</span></summary><div class="mdbody">%s</div></details>'
                  % (esc(when), esc(bot), render_md(body)))
    else:
        report = ('<div class="empty">⚪ %s has not written a report yet — nothing to show.</div>' % esc(bot))

    icon = os.path.join(ICONS, slug + ".png")
    icon_html = ('<img class="icon" src="%s" alt="">' % esc("icons/%s.png" % slug)) if os.path.isfile(icon) else ""

    verdict_cls = "red" if missing else "green"
    verdict = "%d missing" % len(missing) if missing else "nothing missing"

    return """
<article class="app %(vcls)s" id="%(slug)s" data-missing="%(nmiss)d">
  <div class="apphead">
    %(icon)s
    <div class="titles">
      <h2>%(name)s</h2>
      <p class="pkg">%(pkg)s · store page owned by <b>%(bot)s</b></p>
    </div>
    <div class="verdict %(vcls)s">%(verdict)s</div>
  </div>

  <div class="facts">%(facts)s</div>

  <div class="twocol">
    <section class="block missing"><h3>Missing <span class="count">%(nmiss)d</span></h3><ul>%(missing)s</ul></section>
    <section class="block waiting"><h3>Waiting on your yes <span class="count amber">%(nwait)d</span></h3><ol>%(wait)s</ol></section>
  </div>

  %(nextblock)s
  %(notes)s

  <details class="shotsfold" open><summary>Screenshots — what it produced</summary>%(shots)s</details>
  %(report)s
</article>
""" % dict(slug=esc(slug), name=esc(name), pkg=esc(app.get("playPackage") or app.get("bundleId") or ""),
           bot=esc(bot), icon=icon_html, vcls=verdict_cls, verdict=verdict, nmiss=len(missing),
           facts=facts, missing=missing_html, nwait=len(wait), wait=wait_html,
           nextblock=('<p class="next %s">%s</p>' % (nxt_cls, esc(nxt))) if nxt else "", notes=notes_html, shots=shots_html(slug), report=report)


