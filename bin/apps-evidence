SHORT_SIZE = {
    "APP_IPHONE_65": "6.5″", "APP_IPHONE_67": "6.7″", "APP_IPHONE_69": "6.9″",
    "APP_IPHONE_61": "6.1″", "APP_IPHONE_47": "4.7″",
