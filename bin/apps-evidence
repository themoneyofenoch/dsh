JS = """
function receiverDown() {
  if (document.getElementById('downbar')) return;
  var d = document.createElement('div');
  d.id = 'downbar'; d.className = 'downbar';
  d.textContent = 'The tap receiver on this Mac is down — taps and picks will not save. Tell me in chat instead; I am restarting it.';
  document.body.insertBefore(d, document.body.firstChild);
}
fetch('http://127.0.0.1:8791/decisions').then(function (r) { return r.json(); })
  .then(function (list) {
    var last = {};
    (list || []).forEach(function (rec) {
      if (rec && rec.n) last[((rec.app || '').trim().toLowerCase()) + '|' + (rec.step || '').trim()] = rec;
    });
    document.querySelectorAll('td.ans').forEach(function (cell) {
      var rec = last[cell.dataset.app + '|' + cell.dataset.step];
      if (!rec) return;
      if (!cell.querySelector('button')) return;
      var t = (rec.at || '').slice(11, 16);
      cell.innerHTML = '<span class="saved' + (rec.answer === 'hold' ? ' hold' : '') + '">' +
        (rec.answer === 'yes' ? '✅ yes' : '🟡 hold') + ' · ' + t + '</span>';
    });
  }).catch(receiverDown);

document.querySelectorAll('td.ans').forEach(function (cell) {
  cell.addEventListener('click', function (ev) {
    var b = ev.target.closest('button');
    if (!b) return;
    var n = cell.dataset.n, v = b.dataset.v, row = b.closest('tr');
    var app = cell.dataset.app || row.querySelector('td.ap a').textContent;
    var job = cell.dataset.step;
    if (!job) {
      var jc = row.querySelector('td.job');
      job = (jc.firstChild && jc.firstChild.textContent || jc.textContent).trim();
    }
    cell.querySelectorAll('button').forEach(function (x) { x.disabled = true; });
    fetch('http://127.0.0.1:8791/decide', {
      method: 'POST', headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify({ n: +n, app: app, step: job, answer: v })
    }).then(function (r) {
      if (!r.ok) throw new Error(r.status);
      return r.text();
    }).then(function () {
      var t = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      cell.innerHTML = '<span class="saved' + (v === 'hold' ? ' hold' : '') + '">' +
                       (v === 'yes' ? '✅ yes' : '🟡 hold') + ' · ' + t + '</span>';
      var f1 = document.getElementById('yesfoot');
      if (f1) f1.innerHTML = '✅ Saved at ' + t + '. I read this at my next look — the tap card in my chat reaches me the moment you tap.';
    }).catch(function () {
      var q = '?n=' + encodeURIComponent(n) + '&answer=' + encodeURIComponent(v) +
              '&app=' + encodeURIComponent(app) + '&step=' + encodeURIComponent(job);
      var probe = new Image(), settled = false;
      function notSaved() {
        if (settled) return; settled = true;
        cell.innerHTML = '<span class="saved fail">⚠ not saved</span>' +
          '<span class="rebtn"><button data-v="yes">Yes</button><button data-v="hold">Hold</button></span>';
        var f = document.getElementById('yesfoot');
        if (f) f.textContent = 'The tap receiver on this Mac was down — I restarted it. Tap again and this saves.';
      }
      probe.onload = function () {
        if (settled) return; settled = true;
        var t = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        cell.innerHTML = '<span class="saved' + (v === 'hold' ? ' hold' : '') + '">' +
                         (v === 'yes' ? '✅ yes' : '🟡 hold') + ' · ' + t + '</span>';
        var f2 = document.getElementById('yesfoot');
        if (f2) f2.innerHTML = '✅ Saved at ' + t + '. I read this at my next look — the tap card in my chat reaches me the moment you tap.';
      };
      probe.onerror = notSaved;
      probe.src = 'http://127.0.0.1:8791/decide' + q;
      setTimeout(notSaved, 2500);
    });
  });
});

(function () {
  var API = 'http://127.0.0.1:8791';
  var state = {}, order = {};
  function keyOf(c) { return c.dataset.app + '|' + c.dataset.file; }
  function apply() {
    var total = 0, per = {};
    document.querySelectorAll('.pcard').forEach(function (c) {
      var k = keyOf(c), on = !!state[k], app = c.dataset.app;
      c.classList.toggle('on', on);
      c.setAttribute('aria-checked', on ? 'true' : 'false');
      var idx = (order[app] || []).indexOf(c.dataset.file);
      c.querySelector('.tick').textContent = on ? String(idx + 1) : '\u2713';
      if (on) { total += 1; per[app] = (per[app] || 0) + 1; }
    });
    document.querySelectorAll('.pickapp').forEach(function (g) {
      var n = per[g.dataset.app] || 0, el = g.querySelector('.pickcount');
      if (!el) return;
      el.textContent = n + ' of 10 picked';
      el.classList.toggle('over', n > 10);
      el.classList.toggle('some', n > 0 && n <= 10);
    });
    var tt = document.getElementById('picktotal');
    if (tt) tt.textContent = total + ' of ' + document.querySelectorAll('.pcard').length + ' ticked';
  }
  function save(app, file, on) {
    var body = JSON.stringify({ n: 0, app: app, step: file, answer: on ? 'on' : 'off' });
    fetch(API + '/decide', { method: 'POST', headers: { 'Content-Type': 'text/plain' }, body: body })
      .then(function (r) { if (!r.ok) throw new Error(r.status); })
      .catch(function () {
        var probe = new Image();
        probe.src = API + '/decide?n=0&app=' + encodeURIComponent(app) +
          '&step=' + encodeURIComponent(file) + '&answer=' + (on ? 'on' : 'off');
      });
  }
  function toggle(c) {
    var app = c.dataset.app, file = c.dataset.file, k = app + '|' + file;
    var on = !state[k];
    if (on) { state[k] = true; (order[app] = order[app] || []).push(file); }
    else {
      delete state[k];
      order[app] = (order[app] || []).filter(function (f) { return f !== file; });
    }
    apply();
    save(app, file, on);
  }
  document.querySelectorAll('.pcard').forEach(function (c) {
    c.addEventListener('click', function (ev) {
      if (ev.target.closest('a')) return;
      toggle(c);
    });
    c.addEventListener('keydown', function (ev) {
      if (ev.key === ' ' || ev.key === 'Enter') { ev.preventDefault(); toggle(c); }
    });
  });
  fetch(API + '/decisions').then(function (r) { return r.json(); }).then(function (list) {
    (list || []).forEach(function (rec) {
      if (!rec || (rec.answer !== 'on' && rec.answer !== 'off')) return;
      var app = rec.app, file = rec.step, k = app + '|' + file;
      if (rec.answer === 'on') {
        if (!state[k]) { state[k] = true; (order[app] = order[app] || []).push(file); }
      } else {
        delete state[k];
        order[app] = (order[app] || []).filter(function (f) { return f !== file; });
      }
    });
    apply();
  }).catch(receiverDown);
})();

document.querySelectorAll('.filter button').forEach(function (b) {
  b.addEventListener('click', function () {
    var mode = b.dataset.mode;
    document.querySelectorAll('.filter button').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
    b.setAttribute('aria-pressed', 'true');
    document.querySelectorAll('.app').forEach(function (c) {
      var miss = parseInt(c.dataset.missing || '0', 10);
      c.style.display = (mode === 'missing' && miss === 0) ? 'none' : '';
      document.body.classList.toggle('only-missing', mode === 'missing');
    });
  });
});
"""


def main():
    state = load_json(STATE, {})
    apps = state.get("apps") or []
    pending = (load_json(PENDING, {}) or {}).get("apps") or {}
    when = state.get("generatedAt") or ""
    try:
        when = datetime.fromisoformat(when.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d %H:%M %Z")
    except Exception:
        pass

    cards = []
    total_missing = total_wait = 0
    for a in apps:
        slug = a.get("slug")
        wait = pending.get(slug) or []
        card = app_card(a, wait)
        cards.append(card)
    # counts for the header + jump bar (recomputed cheaply from the same JSON)
    jumps = []
    for a in apps:
        n = len(missing_of(a))
        total_missing += n
        total_wait += len(pending.get(a.get("slug")) or [])
        jumps.append('<a class="jump%s" href="#%s">%s%s</a>' % (
            " red" if n else "", esc(a.get("slug")),
            esc(a.get("name") or a.get("slug")), (' · %d' % n) if n else " · ok"))
        jumps[-1] = jumps[-1]

    answers = {}
    try:
        with open(DECISIONS, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                if rec.get("n"):
                    key = ((rec.get("app") or "").strip().lower(), (rec.get("step") or "").strip())
                    answers[key] = rec
    except OSError:
        pass

    rows = []
    n_yes = 0
    for a in apps:
        slug = (a.get("slug") or "")
        for st in norm_steps(pending.get(a.get("slug"))):
            n_yes += 1
            kind = KIND_LABEL.get(st["kind"], "Clear")
            pick = "Go" if st["pick"] == "yes" else ("Hold" if st["pick"] == "hold" else st["pick"])
            why = ('<span class="why">%s</span>' % esc(st["why"])) if st["why"] else ""
            rows.append(
                '<tr><td class="n">%d</td>'
                '<td class="ap"><a href="#%s">%s</a></td>'
                '<td class="job">%s%s</td>'
                '<td class="kind"><span class="badge %s">%s</span></td>'
                '<td class="pick"><b>%s</b></td>'
                '<td class="ans" data-n="%d" data-app="%s" data-step="%s">%s</td></tr>'
                % (n_yes, esc(slug), esc(a.get("name") or a.get("slug")),
                   esc(st["step"]), why, esc(st["kind"]), kind, esc(pick), n_yes,
                   esc(slug.lower()), esc(st["step"]),
                   answered(answers.get((slug.lower(), st["step"].strip())))))
    yes_block = ""
    done_rows = []
    live_keys = set()
    for a in apps:
        for st in norm_steps(pending.get(a.get("slug"))):
            live_keys.add(((a.get("slug") or "").lower(), st["step"].strip()))
    for key, rec in answers.items():
        if key in live_keys:
            continue
        taptime = esc((rec.get("at") or "")[11:16])
        mark = "✅ yes" if (rec.get("answer") or "").lower() == "yes" else "🟡 hold"
        done_rows.append((rec.get("at") or "", '<li><b>%s</b> — %s<span class="when">%s · %s</span></li>'
                          % (esc((rec.get("app") or "").strip()), esc((rec.get("step") or "")[:120]), mark, taptime)))
    done_rows.sort(reverse=True)
    done_html = ""
    if done_rows:
        done_html = ('<div class="done"><b>Done from your taps</b><ul>%s</ul></div>'
                     % "".join(r[1] for r in done_rows[:12]))
    if rows:
        yes_block = (
            '<section class="yeses" id="yeses"><h2>Your yeses '
            '<span class="cnt">%d steps</span></h2>'
            '<p class="yes-lead">Grey means a real choice; Clear means the fact decides it. '
            'My pick sits in its own column — answer with the two buttons.</p>'
            '<div class="tw"><table class="yes"><thead><tr><th>#</th><th>App</th>'
            '<th>What waits</th><th>Kind</th><th>My pick</th><th>Your answer</th></tr></thead>'
            '<tbody>%s</tbody></table></div>%s'
            '<p class="yes-foot" id="yesfoot">A tap here saves on this Mac, and I pick it up at my next look. The tap card in my chat reaches me the moment you tap.</p>'
            '</section>' % (len(rows), "".join(rows), done_html))
        jumps.append('<a class="jump amber" href="#yeses">Your yeses · %d</a>' % len(rows))

    picks_block = picks_html(apps)
    n_shots = sum(len(pick_files(a.get("slug") or "")) for a in apps)
    if picks_block:
        jumps.append('<a class="jump pickjump" href="#picks">Pick your 10 · %d</a>' % n_shots)

    page = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Apps — owner evidence</title>
<style>%(css)s</style></head>
<body>
<div class="topbar"><div class="in">
  <div class="brand">Owner evidence <span>— what each Bot proved</span></div>
  %(jumps)s
</div></div>

<div class="wrap">
  <h1>What each Bot proved</h1>
  <p class="lead">Four apps, four owner Bots. Every line here comes from the stores’ own API,
     from a file in that app’s evidence folder, or from its own report — nothing is typed by hand.</p>
  <p class="stamp">Stores read <b>%(when)s</b> · <b>%(nmiss)d missing</b> across %(napps)d apps ·
     <a class="stamp-link" href="#picks"><b>%(nshots)d candidate shots</b> to tick ↓</a> ·
     <a class="stamp-link" href="#yeses"><b>%(nwait)d steps</b> waiting on your yes ↓</a></p>
  <div class="bar"></div>
  %(yes_block)s
  %(picks)s

  <div class="filter">
    <button data-mode="all" aria-pressed="true">Everything<span class="n">%(napps)d apps</span></button>
    <button data-mode="missing" aria-pressed="false">Only what is missing<span class="n">%(nmiss)d</span></button>
    <span class="n">Screenshots open full size · the long report is folded under each app</span>
  </div>

  %(cards)s

  <p class="foot">Sources: <code>%(state)s</code> (Apple App Store Connect + Google Play + Xcode Cloud + git),
     <code>%(pending)s</code> (steps waiting on Ammaniel), and each app’s
     <code>%(evid)s/&lt;app&gt;/STATUS.md</code> with its <code>shots/</code> folder.<br>
     Regenerate with <code>~/.dsh/bin/apps-evidence</code>.</p>

  <div style="margin-top:22px">
    <a class="pagetab" href="file://%(apps_page)s">← Apps status: what is missing</a>
    <a class="pagetab" href="file://%(proj_page)s">Projects status →</a>
  </div>
</div>
<script>%(js)s</script>
</body></html>
""" % dict(css=CSS, js=JS, jumps="".join(jumps), cards="\n".join(cards), when=esc(when),
           nmiss=total_missing, nwait=total_wait, napps=len(apps), state=STATE, pending=PENDING,
           evid=EVID, apps_page=APPS_PAGE, proj_page=PROJ_PAGE, yes_block=yes_block,
           picks=picks_block, nshots=n_shots)

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(page)
    os.replace(tmp, OUT)
    print("wrote %s (%d apps, %d missing, %d waiting)" % (OUT, len(apps), total_missing, total_wait))


if __name__ == "__main__":
    main()
