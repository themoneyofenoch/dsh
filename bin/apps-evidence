PROJ_PAGE = "/Users/nakfaai/output/projects/status.html"
OWNER = {"kalkidan": "Kalkidan", "pixwee": "Pixwee", "netbrew": "Netbrew", "geezeasy": "GeezEsay"}

IMG_RE = re.compile(r"\.(png|jpe?g)$", re.I)
