#!/usr/bin/env python3
"""apps-yes-server — receives the Yes / Hold taps from evidence.html.

Serves the page itself on http://127.0.0.1:8791/ (same origin, so the tap POST
needs no CORS trick) and appends every answer to
/Users/nakfaai/.dsh/state/apps-decisions.jsonl, one JSON line each.

The page can also be opened as a plain file; then the browser needs CORS, which
this server allows for every origin.

    apps-yes-server            run in the foreground (Ctrl-C to stop)
    apps-yes-server status     is something listening?
    apps-yes-server decisions  print every saved answer
    apps-yes-server pending    print answers not yet acted on (checked every turn)
    apps-yes-server mark       say every answer so far has been acted on
"""
import datetime
import json
import os
import sys
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PAGE = "/Users/nakfaai/output/apps/evidence.html"
OUT = "/Users/nakfaai/.dsh/state/apps-decisions.jsonl"
SEEN = "/Users/nakfaai/.dsh/state/apps-decisions.seen"
PORT = 8791


class Handler(BaseHTTPRequestHandler):
    server_version = "apps-yes/1"

    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")

    def _send(self, code, body, ctype="text/plain; charset=utf-8"):
        self.send_response(code)
        self._cors()
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_GET(self):
        if self.path.split("?")[0] in ("/", "/index.html", "/evidence.html"):
            try:
                with open(PAGE, "rb") as f:
                    self._send(200, f.read(), "text/html; charset=utf-8")
            except OSError:
                self._send(500, b"evidence.html is missing")
            return
        if self.path.split("?")[0] in ("/decisions", "/decisions.json"):
            rows = []
            try:
                with open(OUT, encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line:
                            rows.append(line)
            except OSError:
                pass
            self._send(200, ("[" + ",".join(rows) + "]").encode(), "application/json")
            return
        if self.path.split("?")[0] == "/decide":
            from urllib.parse import parse_qs, urlparse
            q = parse_qs(urlparse(self.path).query)
            rec = {"at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
                   "n": int(q.get("n", ["0"])[0] or 0),
                   "app": q.get("app", [""])[0],
                   "step": q.get("step", [""])[0],
                   "answer": q.get("answer", [""])[0], "via": "beacon"}
            os.makedirs(os.path.dirname(OUT), exist_ok=True)
            with open(OUT, "a", encoding="utf-8") as f:
                f.write(json.dumps(rec, ensure_ascii=False) + "\n")
            self._send(200, b"ok")
            return
        path = self.path.split("?")[0]
        if path.startswith("/evidence/") or path.startswith("/icons/"):
            root = "/Users/nakfaai/output/apps"
            target = os.path.normpath(os.path.join(root, path.lstrip("/")))
            if not target.startswith(root) or not os.path.isfile(target):
                self._send(404, b"no such file")
                return
            ext = os.path.splitext(target)[1].lower()
            ctype = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
                     ".gif": "image/gif", ".webp": "image/webp", ".svg": "image/svg+xml",
                     ".html": "text/html; charset=utf-8"}.get(ext, "application/octet-stream")
            with open(target, "rb") as f:
                self._send(200, f.read(), ctype)
            return
        if path == "/health":
            self._send(200, b"ok")
            return
        self._send(404, b"no such path")

    def do_POST(self):
        if self.path.split("?")[0] != "/decide":
            self._send(404, b"no such path")
            return
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length).decode("utf-8", "replace") if length else ""
        try:
            data = json.loads(raw) if raw else {}
        except Exception:
            data = {"raw": raw}
        record = {
            "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "n": data.get("n"),
            "app": data.get("app"),
            "step": data.get("step"),
            "answer": data.get("answer"),
        }
        os.makedirs(os.path.dirname(OUT), exist_ok=True)
        with open(OUT, "a", encoding="utf-8") as f:
            f.write(json.dumps(record, ensure_ascii=False) + "\n")
        self._send(200, b"ok")

    def log_message(self, fmt, *args):
        pass


def status():
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/health" % PORT, timeout=2) as r:
            print("running on http://127.0.0.1:%d/ (%s)" % (PORT, r.read().decode()))
    except Exception as exc:
        print("not running (%s)" % exc)


def decisions():
    try:
        with open(OUT, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    print(line)
    except OSError:
        print("no answers saved yet (%s)" % OUT)


def pending():
    """Answers saved since the last 'mark'. Empty output means nothing new."""
    try:
        size = os.path.getsize(OUT)
    except OSError:
        print("no answers saved yet (%s)" % OUT)
        return
    try:
        with open(SEEN, encoding="utf-8") as f:
            off = int((f.read() or "0").strip() or 0)
    except (OSError, ValueError):
        off = 0
    if off > size:
        off = 0
    if off == size:
        return
    with open(OUT, encoding="utf-8") as f:
        f.seek(off)
        for line in f:
            line = line.strip()
            if line:
                print(line)


def mark():
    try:
        size = os.path.getsize(OUT)
    except OSError:
        size = 0
    with open(SEEN, "w", encoding="utf-8") as f:
        f.write(str(size))
    print("marked %d answers as acted on" % size)


def main():
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == "status":
            status()
        elif cmd == "decisions":
            decisions()
        elif cmd == "pending":
            pending()
        elif cmd == "mark":
            mark()
        else:
            print(__doc__)
        return
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print("apps-yes-server on http://127.0.0.1:%d/ -> %s" % (PORT, OUT))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
